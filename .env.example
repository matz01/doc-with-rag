# Copy to .env and fill in real values. Never commit .env.

# --- Postgres (docker-compose) ---
POSTGRES_USER=docrag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docrag
POSTGRES_PORT=5432

# --- API ---
API_PORT=8000

# --- Backend outside Docker (compose sets its own DATABASE_URL) ---
DATABASE_URL=postgresql://docrag:change-me@localhost:5432/docrag

# --- Backend integration tests ---
# The tests run against the dedicated `docrag_test` database on the same server as the
# app (created in infra/postgres/init.sql, or by the test fixture itself on existing
# volumes). Set TEST_DATABASE_URL only to point at a different server entirely.
# TEST_DATABASE_URL=postgresql://docrag:change-me@localhost:5432/docrag_test

# --- LLM providers ---
# All providers are OpenAI-compatible: switching is configuration only.
# Choices: mistral | groq | ollama. Leave the fallback empty to disable it.
LLM_PROVIDER=mistral
LLM_FALLBACK_PROVIDER=groq

# Mistral (primary, free Experiment plan)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# Groq (fallback, free tier)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (optional, local, no key). From inside Docker use http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# --- Embeddings (local, sentence-transformers) ---
# The default model pairs with the pinned `vector(1024)` column in the migrations:
# changing it requires re-embedding the whole corpus.
# EMBEDDING_MODEL=BAAI/bge-m3
