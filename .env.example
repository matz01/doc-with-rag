# Copy to .env and fill in real values. Never commit .env.

# --- Postgres (docker-compose) ---
POSTGRES_USER=docrag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docrag
POSTGRES_PORT=5432

# --- API ---
API_PORT=8000

# --- Backend outside Docker (compose sets its own DATABASE_URL) ---
DATABASE_URL=postgresql://docrag:change-me@localhost:5432/docrag

# --- LLM providers ---
# All providers are OpenAI-compatible: switching is configuration only.
# Choices: mistral | groq | ollama. Leave the fallback empty to disable it.
LLM_PROVIDER=mistral
LLM_FALLBACK_PROVIDER=groq

# Mistral (primary, free Experiment plan)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

# Groq (fallback, free tier)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (optional, local, no key). From inside Docker use http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
